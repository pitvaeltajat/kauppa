# Copy to .env.local and fill in. All values are read at runtime.

# --- App ---------------------------------------------------------------------
# Public URL of the app. Used to build the Stripe success/cancel URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database ----------------------------------------------------------------
# Prisma connects with this. POSTGRES_* are consumed by docker-compose.yml when
# you run the local database, so keep them in sync with DATABASE_URL.
DATABASE_URL="postgresql://kauppa:kauppa@localhost:5437/kauppa?schema=public"
POSTGRES_USER="kauppa"
POSTGRES_PASSWORD="kauppa"
POSTGRES_DB="kauppa"

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ----------------------
# Use sk_test_... while the account is in sandbox/test mode.
STRIPE_SECRET_KEY="sk_test_xxx"
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` while
# developing; from Dashboard → Developers → Webhooks in production.
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Auth (Google OAuth via Auth.js) -----------------------------------------
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=""
# Klapi/Budu accept the same values under GOOGLE_CLIENT_ID/SECRET.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: restrict Google sign-in to the troop Workspace domain (enforced,
# not merely a Google UI hint).
GOOGLE_WORKSPACE_DOMAIN=""
# Optional: comma-separated allowlist of admin emails. When empty, every
# sign-in that passes GOOGLE_WORKSPACE_DOMAIN is an admin. When both are empty
# every signed-in Google user is an admin — fine for local dev, do not deploy
# that way.
KAUPPA_ADMIN_EMAILS=""
# Parent domain for the session cookie, e.g. ".pitva.fi". Setting it shares the
# session with Klapi/Budu/landeri — AUTH_SECRET must then hold the SAME value
# as theirs. Leave unset on localhost.
AUTH_COOKIE_DOMAIN=""

# --- Local development only --------------------------------------------------
# Password-less sign-in on /login taking any email address; ignored entirely
# unless NODE_ENV is not "production". The email must end with the domain
# below, or match KAUPPA_SEED_EMAIL.
KAUPPA_DEV_LOGIN="1"
KAUPPA_DEV_DOMAIN="example.com"
KAUPPA_SEED_EMAIL=""

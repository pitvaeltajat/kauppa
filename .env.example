# Copy to .env.local and fill in. All values are read at runtime.

# --- App ---------------------------------------------------------------------
# Public URL of the app. Used to build the Stripe success/cancel URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database ----------------------------------------------------------------
# Prisma connects with this. POSTGRES_* are consumed by docker-compose.yml when
# you run the local database, so keep them in sync with DATABASE_URL.
DATABASE_URL="postgresql://kauppa:kauppa@localhost:5437/kauppa?schema=public"
POSTGRES_USER="kauppa"
POSTGRES_PASSWORD="kauppa"
POSTGRES_DB="kauppa"

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ----------------------
# Use sk_test_... while the account is in sandbox/test mode.
STRIPE_SECRET_KEY="sk_test_xxx"
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` while
# developing; from Dashboard → Developers → Webhooks in production.
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Email (AWS SES, same account/region as klapi) ---------------------------
# Transactional mail: the buyer's receipt when a payment confirms, and an
# optional heads-up to the troop. Leave unset to disable sending (sends are
# wrapped in trySendEmail, so a missing key just logs and is skipped). In local
# dev `pnpm dev` runs aws-ses-v2-local and USE_LOCAL_SES=true, so no real mail
# is sent and these three are ignored.
KAUPPA_AWS_REGION="eu-north-1"
KAUPPA_AWS_ACCESS_KEY_ID=""
KAUPPA_AWS_SECRET_ACCESS_KEY=""
# The verified SES identity mail is sent from, e.g. "kauppa@pitkajarvenvaeltajat.fi".
KAUPPA_SES_FROM_EMAIL=""
# Optional: comma-separated addresses that get a "new order" notice on each paid
# order. Leave unset to send only the buyer's receipt.
ORDER_NOTIFICATION_EMAILS=""

# --- Item photos (S3, same pattern as klapi) ---------------------------------
# Admins upload product/event images straight to a public S3 bucket via a
# presigned POST (app/api/items/upload). Reuses the KAUPPA_AWS_* credentials
# above; that IAM key additionally needs s3:PutObject on the bucket. Leave
# unset to keep the upload button disabled (URL paste still works).
KAUPPA_AWS_BUCKET_NAME=""
# Public base URL the uploaded objects are served from (no trailing slash),
# e.g. "https://kauppa-images.s3.eu-north-1.amazonaws.com" or a CloudFront host.
NEXT_PUBLIC_KAUPPA_ITEM_PHOTOS_URL=""

# --- Auth (Google OAuth via Auth.js) -----------------------------------------
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=""
# Klapi/Budu accept the same values under GOOGLE_CLIENT_ID/SECRET.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: restrict Google sign-in to the troop Workspace domain (enforced,
# not merely a Google UI hint).
GOOGLE_WORKSPACE_DOMAIN=""
# Bootstrap admins, read by `pnpm db:seed`: comma-separated emails that get a
# User row with role ADMIN. After the first admin exists, roles are managed in
# the app under /admin/users — no env variable is read at runtime.
KAUPPA_BOOTSTRAP_ADMIN_EMAILS=""
# Parent domain for the session cookie, e.g. ".pitva.fi". Setting it shares the
# session with Klapi/Budu/landeri — AUTH_SECRET must then hold the SAME value
# as theirs. Leave unset on localhost.
AUTH_COOKIE_DOMAIN=""

# --- Google Workspace user sync (nightly cron) -------------------------------
# Optional. Pre-provisions a User row for every troop member so they show in
# /admin/users before first login. Reuses klapi's `klapi-workspace-sync`
# service account — copy these from klapi's Vercel project. Leave unset to
# disable the sync (the cron just 500s on the missing key, harmless).
#   GOOGLE_WORKSPACE_DOMAIN is the same var the Auth section uses above.
# Service-account JSON key, base64-encoded (survives the Vercel env editor):
GOOGLE_WORKSPACE_SA_KEY=""
# A Workspace admin to impersonate (needs the "read users" privilege):
GOOGLE_WORKSPACE_SUBJECT=""
# The member group whose membership defines "current troop member":
GOOGLE_WORKSPACE_GROUP="jasenet@pitkajarvenvaeltajat.fi"
# Robot/non-person domain accounts to never provision or deactivate (CSV):
GOOGLE_WORKSPACE_EXCLUDE="admin@pitkajarvenvaeltajat.fi"
# Circuit breaker: abort a run that would deactivate more than this many
# accounts (default 10). A half-failed roster read should page a human.
WORKSPACE_SYNC_MAX_DEACTIVATIONS="10"
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`;
# the sync route rejects anything else. Generate: openssl rand -base64 32
CRON_SECRET=""

# --- Kammi (cabin) booking calendar ------------------------------------------
# The kammi booking flow reads/writes a Google Calendar as the availability
# master. Reuses the Workspace service account (GOOGLE_WORKSPACE_SA_KEY above) by
# impersonating the calendar owner, so the SA's domain-wide delegation must also
# include https://www.googleapis.com/auth/calendar.events. Leave KAMMI_CALENDAR_ID
# unset to run on kauppa's own bookings only (no external calendar sync).
KAMMI_CALENDAR_ID=""
# A user who can edit that calendar, impersonated for calendar calls (the owner).
KAMMI_CALENDAR_SUBJECT="admin@pitva.fi"
# The cabin host: gets a new-booking notice, and signs the post-stay feedback
# mail. Defaults to Paavali Keppo if unset.
KAMMI_HOST_EMAIL="paavali.keppo@pitkajarvenvaeltajat.fi"
# The feedback form the post-stay mail links to (migrated from palaute()).
KAMMI_FEEDBACK_URL="https://bit.ly/kamminpalautelomake"

# --- Local development only --------------------------------------------------
# Password-less sign-in on /login taking any email address; ignored entirely
# unless NODE_ENV is not "production". The email must end with the domain
# below, or match KAUPPA_SEED_EMAIL.
KAUPPA_DEV_LOGIN="1"
KAUPPA_DEV_DOMAIN="example.com"
KAUPPA_SEED_EMAIL=""

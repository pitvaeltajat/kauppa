generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Anyone who has signed in. Roles are derived on sign-in (lib/auth.ts):
/// a pitva-domain Google account becomes EVENT_ADMIN automatically; USER is
/// everyone else (parents normally never log in). SUPERADMIN is the one manual
/// grant — only a superadmin sets it, and it is never auto-downgraded.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  EVENT_ADMIN
  SUPERADMIN
}

/// A shop section, e.g. "PitVa-tuotteet". Fully editable from the admin UI —
/// nothing here is hardcoded.
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([sortOrder])
}

/// One sellable thing, with 0..n questions the buyer answers at checkout
/// (TEXT, NUMBER, RADIO or CHECKBOX) — e.g. a huppari size or a name for a
/// custom item. Answers are snapshotted onto the order line.
model Item {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @default("")
  priceCents  Int
  /// Image URL shown in the catalog. NULL renders the "Ei kuvaa" placeholder.
  imageUrl    String?
  /// NULL = unlimited stock (bundle offers, event registrations).
  stock       Int?
  /// Inactive items are not shown in the catalog or buyable, but keep their
  /// order history (a discontinued product). The hard off switch.
  active      Boolean        @default(true)
  /// An event is a special item: a registration/fee with start+end dates that
  /// auto-hides from listings one week after it ends. Managed by event admins.
  isEvent     Boolean        @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Unlisted: kept off the front page and category listings but still
  /// reachable and buyable at its direct /item/<slug> link. Used for events
  /// shared by link only; also applied automatically once an event is over.
  hidden      Boolean        @default(false)
  sortOrder   Int            @default(0)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderLines  OrderLine[]
  questions   ItemQuestion[]

  @@index([categoryId, active])
}

/// One question asked at checkout for an item ("Hupparin koko", "Nimikyltin
/// teksti"). RADIO and CHECKBOX read their choices from `options` (string[]);
/// TEXT and NUMBER ignore it. `required` only applies to TEXT and NUMBER —
/// choice questions must always have an answer.
model ItemQuestion {
  id        String       @id @default(cuid())
  itemId    String
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType @default(TEXT)
  required  Boolean      @default(false)
  options   Json         @default("[]")
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([itemId])
}

enum QuestionType {
  TEXT
  NUMBER
  RADIO
  CHECKBOX
}

/// One checkout. Lines are a snapshot: renaming or deleting an item later does
/// not rewrite what the order says was bought.
model Order {
  id                  String      @id @default(cuid())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  status              OrderStatus @default(RECEIVED)
  email               String?
  name                String?
  totalCents          Int
  stripeSessionId     String?     @unique
  stripePaymentIntent String?
  paidAt              DateTime?
  lines               OrderLine[]

  @@index([status, createdAt])
}

model OrderLine {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item    @relation(fields: [itemId], references: [id])
  name       String
  priceCents Int
  quantity   Int
  /// Snapshot of the buyer's answers to the item's checkout questions:
  /// [{ questionId, prompt, type, answer }]. Survives question edits/deletes.
  answers    Json?

  @@index([orderId])
}

enum OrderStatus {
  RECEIVED
  PAID
  COMPLETED
  CANCELLED
}

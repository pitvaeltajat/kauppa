generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Anyone who has signed in, or who the nightly Workspace sync pre-provisioned.
/// Roles are derived on sign-in (lib/auth.ts): a pitva-domain Google account
/// becomes EVENT_ADMIN automatically; USER is everyone else (parents normally
/// never log in). SUPERADMIN is the one manual grant — only a superadmin sets
/// it, and it is never auto-downgraded.
///
/// `deletedAt` soft-deletes a departed member: the Workspace sync stamps it
/// when someone leaves the member group (and clears it if they return), and
/// lib/auth.ts refuses their sign-in while it is set. `deletedBySync` records
/// that the sync, not a human, did it — a hand-deletion is never auto-restored.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role      @default(USER)
  deletedAt     DateTime?
  deletedBySync Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  EVENT_ADMIN
  SUPERADMIN
}

/// A shop section, e.g. "PitVa-tuotteet". Fully editable from the admin UI —
/// nothing here is hardcoded.
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([sortOrder])
}

/// Internal accounting grouping. Never shown in the public shop.
model AccountingClass {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  kammiBookings KammiBooking[]
  kammiSettings KammiSettings[]

  @@index([sortOrder, name])
}

/// One sellable thing, with 0..n questions the buyer answers at checkout
/// (TEXT, NUMBER, RADIO or CHECKBOX) — e.g. a huppari size or a name for a
/// custom item. Answers are snapshotted onto the order line.
model Item {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String         @default("")
  priceCents     Int
  /// Image URL shown in the catalog. NULL renders the "Ei kuvaa" placeholder.
  imageUrl       String?
  /// NULL = unlimited stock (bundle offers, event registrations).
  stock          Int?
  /// Inactive items are not shown in the catalog or buyable, but keep their
  /// order history (a discontinued product). The hard off switch.
  active         Boolean        @default(true)
  /// An event is a special item: a registration/fee with start+end dates that
  /// auto-hides from listings one week after it ends. Managed by event admins.
  isEvent        Boolean        @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  /// Unlisted: kept off the front page and category listings but still
  /// reachable and buyable at its direct /item/<slug> link. Used for events
  /// shared by link only; also applied automatically once an event is over.
  hidden         Boolean        @default(false)
  /// This event opts into the "leaders' discount": a DiscountCode with
  /// `leaderOnly` (e.g. JOHTAJA) only discounts lines whose item has this set.
  leaderDiscount Boolean        @default(false)
  /// Shown in the front-page "Nostot" section and first within its category.
  featured       Boolean        @default(false)
  featuredOrder  Int            @default(0)
  sortOrder      Int            @default(0)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountingClassId String?
  accountingClass   AccountingClass? @relation(fields: [accountingClassId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orderLines     OrderLine[]
  questions      ItemQuestion[]
  pastSlugs      ItemSlug[]

  @@index([categoryId, active])
}

/// A slug this item used to have. When an admin edits an item's slug, the old
/// one is kept here so shared links (/item/<old-slug>) keep working — the item
/// page resolves a past slug and permanent-redirects to the current URL.
model ItemSlug {
  slug      String   @id
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([itemId])
}

/// One question asked at checkout for an item ("Hupparin koko", "Nimikyltin
/// teksti"). RADIO and CHECKBOX read their choices from `options` (string[]);
/// TEXT and NUMBER ignore it. `required` only applies to TEXT and NUMBER —
/// choice questions must always have an answer.
model ItemQuestion {
  id        String       @id @default(cuid())
  itemId    String
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType @default(TEXT)
  required  Boolean      @default(false)
  options   Json         @default("[]")
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([itemId])
}

enum QuestionType {
  TEXT
  NUMBER
  RADIO
  CHECKBOX
}

/// A reusable discount code the buyer types in the cart. Percentage off,
/// optionally expiring. `leaderOnly` is the one scope switch: a leaderOnly code
/// (e.g. JOHTAJA, 50 %) discounts only lines whose Item has `leaderDiscount`;
/// a normal code discounts the whole cart. `code` is stored uppercased and is
/// matched case-insensitively.
model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String    @default("")
  percentOff  Int
  leaderOnly  Boolean   @default(false)
  active      Boolean   @default(true)
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// One checkout. Lines are a snapshot: renaming or deleting an item later does
/// not rewrite what the order says was bought.
model Order {
  id                  String      @id @default(cuid())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  status              OrderStatus @default(RECEIVED)
  email               String?
  name                String?
  totalCents          Int
  stripeSessionId     String?     @unique
  stripePaymentIntent String?
  /// Random bearer token for a child-created event registration payment link.
  paymentToken        String?     @unique
  paymentLinkEmailSentAt DateTime?
  stripeCustomerId    String?
  stripeInvoiceId     String?     @unique
  checkoutKey         String?     @unique
  invoiceAccessToken  String?     @unique
  invoiceAccessTokenExpiresAt DateTime?
  invoiceUrl          String?
  invoicePdfUrl       String?
  invoiceDueAt        DateTime?
  paidAt              DateTime?
  lines               OrderLine[]

  @@index([status, createdAt])
}

model OrderLine {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id])
  name         String
  priceCents   Int
  quantity     Int
  /// Snapshot of the buyer's answers to the item's checkout questions:
  /// [{ questionId, prompt, type, answer }]. Survives question edits/deletes.
  answers      Json?
  participants Participant[]

  @@index([orderId])
}

/// One person occupying one spot on an event order line. The buyer on Order
/// remains the billing/contact person; this row is the actual attendee.
model Participant {
  id          String    @id @default(cuid())
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  name        String
  answers     Json?
  createdAt   DateTime  @default(now())

  @@index([orderLineId])
}

enum OrderStatus {
  RECEIVED
  PAID
  COMPLETED
  CANCELLED
}

/// A booking of the kammi (the troop's rental cabin). A special one-cabin flow:
/// pick dates on /kammi, pay, and get the door keycode + instructions by email
/// — only paying reveals them. Availability master data lives in Google
/// Calendar; a CONFIRMED booking also writes an event there.
///
/// `startDate`..`endDate` is a half-open range `[startDate, endDate)`: the guest
/// leaves on `endDate`, which is free again for the next arrival. Overlaps are
/// forbidden at the database level by an exclusion constraint over that range
/// for non-CANCELLED rows (see the migration — Prisma can't express it). A
/// PENDING hold past `holdExpiresAt` is stale and gets cancelled, freeing the
/// dates; the hard guarantee is that two CONFIRMED bookings can never overlap.
model KammiBooking {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  nights          Int
  /// Which rate applied: SCOUT (partiolainen) or OTHER (muu).
  tier            KammiTier     @default(OTHER)
  status          BookingStatus @default(PENDING)
  email           String?
  name            String?
  phone           String?
  /// The organisation the booker represents ("Varaajan edustama taho").
  organization    String?
  /// Free description of the event/visit ("Tapahtuman tiedot").
  eventInfo       String?
  /// Questions for the cabin host ("Kysymykset kämppäisännälle").
  hostQuestions   String?
  /// Invoicing email if different from the contact ("Laskutusosoite").
  billingEmail    String?
  accountingClassId String?
  accountingClass   AccountingClass? @relation(fields: [accountingClassId], references: [id], onDelete: SetNull)
  totalCents      Int
  stripeSessionId String?       @unique
  requestKey      String?       @unique
  /// Random bearer token for a payer-separated booking payment link.
  paymentToken    String?       @unique
  holdExpiresAt   DateTime?
  googleEventId   String?
  paidAt          DateTime?
  /// When the post-stay feedback request was sent, so it is sent only once.
  feedbackSentAt  DateTime?

  @@index([status, startDate])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum KammiTier {
  SCOUT
  OTHER
}

/// Singleton shop-wide settings (exactly one row, id "singleton"), edited in
/// admin. Currently just the front-page banner background image.
model SiteSettings {
  id             String   @id @default("singleton")
  updatedAt      DateTime @updatedAt
  /// Background photo for the front-page banner. NULL = plain banner, no photo.
  bannerImageUrl String?
  /// CSS background-position for the banner image, e.g. "50% 50%".
  bannerPosition String @default("50% 50%")
}

/// Singleton settings for the kammi rental (exactly one row, id "singleton"),
/// edited in admin so prices, keycode and instructions change without a deploy.
/// Prices mirror the published list: a flat weekend package (Fri→Sun) and a
/// per-night weekday rate, each in a scout and a non-scout tier (cents).
model KammiSettings {
  id                String   @id @default("singleton")
  updatedAt         DateTime @updatedAt
  active            Boolean  @default(false)
  weekendScoutCents Int      @default(20000)
  weekendOtherCents Int      @default(30000)
  weekdayScoutCents Int      @default(5000)
  weekdayOtherCents Int      @default(10000)
  minNights         Int      @default(1)
  maxNights         Int      @default(14)
  accountingClassId String
  accountingClass   AccountingClass @relation(fields: [accountingClassId], references: [id], onDelete: Restrict)
  /// Door keycode — only the paid confirmation email carries it, never a public page.
  keycode           String   @default("")
  /// Free-text instructions appended to the confirmation email.
  instructions      String   @default("")
}
